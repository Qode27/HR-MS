# BuildKit picks this file up automatically because it sits next to
# devops-project/docker/Dockerfile. It keeps secrets, build output and
# deployment junk out of the image and makes builds faster.
.git
.gitignore
node_modules
.next
coverage
test-results
tmp
logs
*.log
uploads
data

# Never ship environment files or secrets
.env
.env.*
!.env.example

# Old manual deployment artefacts
deploy-hrms
qode27-*
*.zip

# The DevOps project itself
devops-project
