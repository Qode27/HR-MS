# Day 3 Terraform lab - small, cheap, about 2 minutes to apply.
# Creates: resource group + storage account + Key Vault holding a generated secret.
# Teaches: providers, resources, variables, outputs, plan/apply/destroy, state,
#          drift detection, and secrets that are generated by Terraform, stored in
#          Key Vault and pulled by the app at deploy time - never written in code.
#
#   az login
#   export ARM_SUBSCRIPTION_ID=$(az account show --query id -o tsv)
#   terraform init && terraform plan -var="student=<yourname>" && terraform apply -var="student=<yourname>"
#   az keyvault secret show --vault-name $(terraform output -raw key_vault_name) -n jwt-secret --query value -o tsv
#   ../../scripts/env-from-keyvault.sh        # builds docker/.env.compose from Key Vault
#   terraform destroy -var="student=<yourname>"

terraform {
  required_version = ">= 1.9.0"
  required_providers {
    azurerm = { source = "hashicorp/azurerm", version = "~> 4.0" }
    random  = { source = "hashicorp/random", version = "~> 3.6" }
  }
  # State is LOCAL here on purpose (look at terraform.tfstate after apply).
  # The production code in ../ uses a remote azurerm backend with locking.
}

provider "azurerm" {
  features {
    key_vault {
      purge_soft_delete_on_destroy = true # lab only, so destroy really cleans up
    }
  }
}

variable "student" {
  description = "Your name, lowercase letters only - makes names unique."
  type        = string
  validation {
    condition     = can(regex("^[a-z]{2,10}$", var.student))
    error_message = "Use 2-10 lowercase letters."
  }
}

variable "location" {
  type    = string
  default = "centralindia"
}

variable "postgres_user" {
  type    = string
  default = "peopleflow"
}

variable "postgres_db" {
  type    = string
  default = "peopleflow_hr"
}

locals {
  tags = { project = "peopleflow", purpose = "training", student = var.student, managed_by = "terraform" }
}

data "azurerm_client_config" "me" {}

resource "random_string" "suffix" {
  length  = 4
  upper   = false
  special = false
}

resource "azurerm_resource_group" "lab" {
  name     = "rg-pf-lab-${var.student}"
  location = var.location
  tags     = local.tags
}

resource "azurerm_storage_account" "lab" {
  name                            = "stpf${var.student}${random_string.suffix.result}"
  resource_group_name             = azurerm_resource_group.lab.name
  location                        = azurerm_resource_group.lab.location
  account_tier                    = "Standard"
  account_replication_type        = "LRS"
  min_tls_version                 = "TLS1_2"
  allow_nested_items_to_be_public = false
  tags                            = local.tags
}

resource "azurerm_key_vault" "lab" {
  name                       = "kv-pf-${var.student}-${random_string.suffix.result}"
  resource_group_name        = azurerm_resource_group.lab.name
  location                   = azurerm_resource_group.lab.location
  tenant_id                  = data.azurerm_client_config.me.tenant_id
  sku_name                   = "standard"
  soft_delete_retention_days = 7
  purge_protection_enabled   = false # lab only
  tags                       = local.tags

  # Least privilege: only YOU, only secret operations.
  access_policy {
    tenant_id          = data.azurerm_client_config.me.tenant_id
    object_id          = data.azurerm_client_config.me.object_id
    secret_permissions = ["Get", "List", "Set", "Delete", "Purge", "Recover"]
  }
}

resource "random_password" "jwt" {
  length  = 48
  special = false
}

resource "random_password" "postgres" {
  length  = 24
  special = false # keeps the connection URL free of characters that need encoding
}

# Rotation drill: terraform apply -replace=random_password.jwt -var="student=<you>"
resource "azurerm_key_vault_secret" "jwt" {
  name         = "jwt-secret"
  value        = random_password.jwt.result
  key_vault_id = azurerm_key_vault.lab.id
  content_type = "text/plain"
  tags         = { used_by = "peopleflow-web" }
}

resource "azurerm_key_vault_secret" "postgres" {
  name         = "postgres-password"
  value        = random_password.postgres.result
  key_vault_id = azurerm_key_vault.lab.id
  content_type = "text/plain"
  tags         = { used_by = "peopleflow-db" }
}

# Non-secret settings live in Key Vault too here, so one place holds the
# whole app configuration for this environment.
resource "azurerm_key_vault_secret" "postgres_user" {
  name         = "postgres-user"
  value        = var.postgres_user
  key_vault_id = azurerm_key_vault.lab.id
  content_type = "text/plain"
}

resource "azurerm_key_vault_secret" "postgres_db" {
  name         = "postgres-db"
  value        = var.postgres_db
  key_vault_id = azurerm_key_vault.lab.id
  content_type = "text/plain"
}

output "resource_group" {
  value = azurerm_resource_group.lab.name
}

output "storage_account" {
  value = azurerm_storage_account.lab.name
}

output "key_vault_name" {
  value = azurerm_key_vault.lab.name
}

output "key_vault_secrets" {
  description = "Names only - values never appear in outputs."
  value = [
    azurerm_key_vault_secret.jwt.name,
    azurerm_key_vault_secret.postgres.name,
    azurerm_key_vault_secret.postgres_user.name,
    azurerm_key_vault_secret.postgres_db.name,
  ]
}
